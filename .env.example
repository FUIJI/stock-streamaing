# ---------- TimescaleDB ----------
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock_dev_password
POSTGRES_DB=stocks

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- Kafka / Redpanda ----------
KAFKA_BROKER=redpanda:9092
TRADES_TOPIC=trades.raw

# ---------- Ingestion ----------
# simulator | finnhub | alpaca
TRADE_SOURCE=simulator
FINNHUB_API_KEY=
# Alpaca (free paper account): https://app.alpaca.markets -> API keys
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex (free real-time) | sip (paid) | test (synthetic FAKEPACA, 24/7)
ALPACA_FEED=iex
SYMBOLS=AAPL,MSFT,NVDA,TSLA
# simulator only: trades per second per symbol
SIM_TRADES_PER_SEC=5

# ---------- Lite stack (docker-compose.prod.yml) ----------
# Shared secret between ingestion and the API's /internal/ingest socket.
# Generate a real one for any deployment: openssl rand -hex 32
INGEST_TOKEN=dev-ingest-token
# Point at Supabase/Neon in production (lite stack only; defaults = local postgres profile)
# PG_HOST=
# PG_PORT=5432
# Host interface the API port binds to (keep 127.0.0.1 behind a reverse proxy)
# API_BIND=127.0.0.1
